#!/usr/bin/env bash
# bin/detect <build-dir>
# Exits 0 with "Bun" on stdout if the app is a Bun project.
# Exits 1 otherwise.
set -euo pipefail

BUILD_DIR="${1:-}"

if [[ -z "$BUILD_DIR" ]] || [[ ! -d "$BUILD_DIR" ]]; then
  exit 1
fi

# Tier 1: Bun-exclusive files (highest confidence)

# Bun's text lockfile (default since v1.2)
if [ -f "$BUILD_DIR/bun.lock" ]; then
  echo "Bun"; exit 0
fi

# Bun's legacy binary lockfile
if [ -f "$BUILD_DIR/bun.lockb" ]; then
  echo "Bun"; exit 0
fi

# Explicit Bun version pin files
if [ -f "$BUILD_DIR/.bun-version" ] || \
   [ -f "$BUILD_DIR/runtime.bun.txt" ]; then
  echo "Bun"; exit 0
fi

# Bun config file
if [ -f "$BUILD_DIR/bunfig.toml" ] || \
   [ -f "$BUILD_DIR/.bunfig.toml" ]; then
  echo "Bun"; exit 0
fi

# Tier 2: package.json Bun-specific fields (high confidence)

if [ -f "$BUILD_DIR/package.json" ]; then

  if command -v jq >/dev/null 2>&1; then
    # packageManager field explicitly set to bun (e.g. "bun@1.2.0")
    if jq -e '.packageManager? | strings | startswith("bun@")' "$BUILD_DIR/package.json" >/dev/null 2>&1; then
      echo "Bun"; exit 0
    fi

    # engines.bun field present (e.g. "engines": { "bun": "1.2.0" })
    if jq -e '.engines? | objects | has("bun")' "$BUILD_DIR/package.json" >/dev/null 2>&1; then
      echo "Bun"; exit 0
    fi
  else
    if grep -q '"packageManager"[[:space:]]*:[[:space:]]*"bun@' \
         "$BUILD_DIR/package.json" 2>/dev/null; then
      echo "Bun"; exit 0
    fi

    # Fallback to context-aware grep if jq is missing.
    if grep -A 10 '"engines"' "$BUILD_DIR/package.json" 2>/dev/null \
         | grep -q '"bun"[[:space:]]*:'; then
      echo "Bun"; exit 0
    fi
  fi

fi

# No Bun signals found
exit 1
