#!/usr/bin/env bash
# bin/release <build-dir>
# Prints YAML metadata for the Heroku runtime.
#
# NOTE: set -euo pipefail is safe here because all has_script calls are
# inside [[ ]] conditionals, which are exempt from errexit.
set -euo pipefail
#
# default_process_types is ONLY used when no Procfile is present.
# It can contain multiple process types - Heroku uses whichever the user scales.
#
# Detection logic (all sourced from package.json scripts):
#   "start"  or "web"    -> web dyno   (bun run <script>)
#   "worker"             -> worker dyno
#   "release"            -> release dyno (runs once per deploy)
#   "scheduler"          -> scheduler dyno
#   No matching scripts  -> falls back to common entry file for web

BUILD_DIR="${1:-}"
BP_DIR=$(cd "$(dirname "$0")"; cd ..; pwd)

source "$BP_DIR/lib/json.sh"

PKG="$BUILD_DIR/package.json"


# Build the default_process_types block.
PROCESS_TYPES=""

# If the user provides a Procfile, Heroku will use it. We should NOT try to
# provide default_process_types, otherwise Heroku will merge our guessed 'web'
# process with their Procfile (e.g., resulting in both 'web' and 'worker' running).
if [[ ! -f "$BUILD_DIR/Procfile" ]]; then

  # One jq call for all script keys (vs 4+ has_script forks before).
  if [[ -f "$PKG" ]]; then
    SCRIPTS=" $(json_script_keys "$PKG") "
    case "$SCRIPTS" in *" web "*) PROCESS_TYPES+="  web: bun run web"$'\n' ;; esac
    case "$SCRIPTS" in
      *" web "*) ;;
      *" start "*) PROCESS_TYPES+="  web: bun run start"$'\n' ;;
    esac
    for _pt in worker release scheduler; do
      case "$SCRIPTS" in *" $_pt "*) PROCESS_TYPES+="  $_pt: bun run $_pt"$'\n' ;; esac
    done
  fi

  # Fallback: if no process types were explicitly defined in package.json,
  # scan for common entry files and assume it's a web dyno.
  if [[ -z "$PROCESS_TYPES" ]]; then
    for entry in "index.ts" "index.js" "src/index.ts" "src/index.js" \
                 "main.ts" "main.js" "app.ts" "app.js" "server.ts" "server.js"; do
      if [[ -f "$BUILD_DIR/$entry" ]]; then
        PROCESS_TYPES+="  web: bun run $entry"$'\n'
        break
      fi
    done
  fi
fi

# Emit YAML.
echo "---"
echo "addons: []"

if [[ -n "$PROCESS_TYPES" ]]; then
  echo "default_process_types:"
  printf "%s" "$PROCESS_TYPES"
fi
