#!/usr/bin/env bash
# bin/test
# Basic smoke tests for the buildpack - run via: heroku buildpacks:test
# Supported stacks: heroku-22, heroku-24, heroku-26

set -euo pipefail

BP_DIR=$(cd "$(dirname "$0")"; cd ..; pwd)

pass() { echo "  PASS: $*"; }
fail() { echo "  FAIL: $*" >&2; exit 1; }

echo "-----> Running buildpack tests"

# Section 1: Sanity checks

# 1. Required scripts are executable
for script in detect compile release; do
  [ -x "$BP_DIR/bin/$script" ] \
    && pass "bin/$script is executable" \
    || fail "bin/$script is not executable"
done

# 2. Required tools present on build dyno
for tool in jq curl unzip bash; do
  command -v "$tool" &>/dev/null \
    && pass "$tool is available" \
    || fail "$tool is required but not found"
done

tmpdirs=()
new_tmp() { local _var=$1 _d; _d=$(mktemp -d); tmpdirs+=("$_d"); printf -v "$_var" '%s' "$_d"; }
cleanup_test_tmp() { rm -rf "${tmpdirs[@]:-}"; }
trap cleanup_test_tmp EXIT

expect_detect() { # $1=0|1 expected exit, $2=dir, $3=message
  local got
  if "$BP_DIR/bin/detect" "$2" &>/dev/null; then got=0; else got=1; fi
  [ "$got" = "$1" ] && pass "$3" || fail "$3 (want exit $1, got $got)"
}

expect_script() { # $1=file $2=key $3=want $4=message
  local got
  got=$(has_script "$1" "$2")
  [ "$got" = "$3" ] && pass "$4" || fail "$4 (got $got)"
}

expect_release_contains() { # $1=dir $2=pattern $3=message
  local out
  out=$("$BP_DIR/bin/release" "$1")
  if echo "$out" | grep -q "$2"; then pass "$3"; else echo "$out"; fail "$3"; fi
}

# Section 2: Detection tests

# 3. detect rejects a non-Bun directory
new_tmp tmp_empty
expect_detect 1 "$tmp_empty" "detect correctly rejects non-Bun directory"

# 4. detect rejects a bare package.json (no Bun signals)
new_tmp tmp_pkg
echo '{}' > "$tmp_pkg/package.json"
expect_detect 1 "$tmp_pkg" "detect correctly rejects bare package.json"

# 5. detect accepts a directory with .bun-version
new_tmp tmp_bun
echo 'v1.3.13' > "$tmp_bun/.bun-version"
expect_detect 0 "$tmp_bun" "detect correctly accepts directory with .bun-version"

# 6. detect accepts a directory with bun.lock
new_tmp tmp_lock
echo '{}' > "$tmp_lock/bun.lock"
expect_detect 0 "$tmp_lock" "detect correctly accepts directory with bun.lock"

# 7. detect accepts a directory with bun.lockb (legacy binary lockfile)
new_tmp tmp_lockb
touch "$tmp_lockb/bun.lockb"
expect_detect 0 "$tmp_lockb" "detect correctly accepts directory with bun.lockb"

# 8. detect accepts package.json with packageManager set to bun
new_tmp tmp_pm
echo '{"packageManager": "bun@1.2.0"}' > "$tmp_pm/package.json"
expect_detect 0 "$tmp_pm" "detect correctly accepts packageManager=bun"

# 9. detect accepts package.json with engines.bun
new_tmp tmp_engines
echo '{"engines": {"bun": ">=1.0.0"}}' > "$tmp_engines/package.json"
expect_detect 0 "$tmp_engines" "detect correctly accepts engines.bun"

# 10. detect accepts bunfig.toml
new_tmp tmp_bunfig
touch "$tmp_bunfig/bunfig.toml"
expect_detect 0 "$tmp_bunfig" "detect correctly accepts bunfig.toml"

# 11. detect rejects package.json with engines.node but no engines.bun
new_tmp tmp_node
echo '{"engines": {"node": ">=18"}}' > "$tmp_node/package.json"
expect_detect 1 "$tmp_node" "detect correctly rejects engines.node without engines.bun"

# 12. detect rejects non-existent directory
expect_detect 1 "/tmp/this-path-does-not-exist-$$" "detect correctly rejects non-existent directory"

# Section 3: JSON helper tests

source "$BP_DIR/lib/json.sh"

# 13-16. has_script matrix
new_tmp tmp_json
echo '{"scripts": {"start": "bun index.js", "build": "bun build"}}' > "$tmp_json/package.json"
echo '{}' > "$tmp_json/no-scripts.json"
echo '{"scripts": null}' > "$tmp_json/null-scripts.json"
expect_script "$tmp_json/package.json" "start" "true" "has_script finds existing script"
expect_script "$tmp_json/package.json" "nonexistent" "false" "has_script returns false for missing script"
expect_script "$tmp_json/no-scripts.json" "start" "false" "has_script returns false when scripts is missing"
expect_script "$tmp_json/null-scripts.json" "start" "false" "has_script returns false when scripts is null"

# 17-18. is_invalid_json_file
echo 'not valid json{' > "$tmp_json/bad.json"
expect_invalid() { # $1=file $2=want $3=message
  local got
  got=$(is_invalid_json_file "$1")
  [ "$got" = "$2" ] && pass "$3" || fail "$3 (got $got)"
}
expect_invalid "$tmp_json/bad.json" "true" "is_invalid_json_file correctly detects invalid JSON"
expect_invalid "$tmp_json/package.json" "false" "is_invalid_json_file correctly passes valid JSON"

# Section 4: Release script tests

# 19. release outputs web: bun run start for start script
new_tmp tmp_rel
echo '{"scripts": {"start": "bun run index.js"}}' > "$tmp_rel/package.json"
expect_release_contains "$tmp_rel" "web: bun run start" "release outputs 'web: bun run start' for start script"

# 20. release outputs worker process type
new_tmp tmp_worker
echo '{"scripts": {"start": "bun run index.js", "worker": "bun run worker.js"}}' > "$tmp_worker/package.json"
expect_release_contains "$tmp_worker" "worker: bun run worker" "release outputs worker process type"

# 21. release prefers 'web' script over 'start'
new_tmp tmp_web
echo '{"scripts": {"web": "bun serve.js", "start": "bun index.js"}}' > "$tmp_web/package.json"
expect_release_contains "$tmp_web" "web: bun run web" "release prefers 'web' script over 'start'"

# 22. release falls back to entry file when no scripts defined
new_tmp tmp_entry
echo '{}' > "$tmp_entry/package.json"
echo 'console.log("hello")' > "$tmp_entry/index.ts"
expect_release_contains "$tmp_entry" "web: bun run index.ts" "release falls back to index.ts entry file"

# Section 5: Compile unit tests (no network)

source "$BP_DIR/lib/version.sh"

# 23-24. normalize_bun_version accepts exact forms, rejects ranges
for vcase in "1.3.13:v1.3.13" "v1.3.13:v1.3.13" "bun-v1.3.13:v1.3.13" "latest:latest" "canary:canary"; do
  raw="${vcase%%:*}"; want="${vcase##*:}"
  got=$(normalize_bun_version "$raw")
  [ "$got" = "$want" ] \
    && pass "normalize_bun_version '$raw' -> '$want'" \
    || fail "normalize_bun_version '$raw' gave '$got', want '$want'"
done
for bad in ">=1.0.0" "^1.3.0" "~1.3.0" "" "abc" "1.3"; do
  if normalize_bun_version "$bad" >/dev/null 2>&1; then
    fail "normalize_bun_version should reject '$bad'"
  else
    pass "normalize_bun_version rejects '$bad'"
  fi
done

# 24. runtime.txt guard handles foreign values (behavior covered live in #27-28)
expect_grep() { # $1=pattern $2=file $3=message
  grep -q "$1" "$2" && pass "$3" || fail "$3"
}
expect_grep "Ignoring runtime.txt" "$BP_DIR/bin/compile" "compile ignores foreign runtime.txt"
expect_grep "set -f" "$BP_DIR/bin/compile" "BUN_INSTALL_FLAGS split disables globbing"

# 25. ENV_DIR blocklist covers dynamic-loader variables
for blocked in "LD_AUDIT" "LD_CONFIG" "PS4"; do
  expect_grep "$blocked" "$BP_DIR/bin/compile" "ENV_DIR blocklist covers $blocked"
done

# Section 6: Compile + Release integration test

# 26. compile and release integration test (end-to-end)
new_tmp tmp_app
new_tmp tmp_cache
new_tmp tmp_env

# The standard x64 Bun binary requires AVX2 and crashes (SIGILL) on CPUs without
# it (e.g. some low-power Intel/AMD). Use the baseline variant there. We pin a
# recent version whose binary is runnable on CI runners (they have AVX2), which
# also avoids the ancient v1.0.0 binary failing on newer glibc.
if ! grep -qi 'avx2' /proc/cpuinfo 2>/dev/null; then
  export BUN_BINARY_VARIANT="baseline"
fi
TEST_BUN_VERSION="1.3.13"

# Setup a basic bun app
echo '{"scripts": {"start": "bun run index.js"}}' > "$tmp_app/package.json"
echo 'console.log("Hello from tests!")' > "$tmp_app/index.js"
echo "v$TEST_BUN_VERSION" > "$tmp_app/.bun-version"

# Skip the network-dependent compile test when we can't reach GitHub.
if ! curl -fsSI --max-time 10 >/dev/null 2>&1 \
     "https://github.com/oven-sh/bun/releases/download/bun-v${TEST_BUN_VERSION}/bun-linux-x64.zip"; then
  echo "  SKIP: compile integration test (no network access to GitHub)"
else
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile successfully builds a basic app"
  else
    echo "$compile_out"
    fail "compile failed on a basic app"
  fi

  expect_release_contains "$tmp_app" "web: bun run start" "release outputs correct web process type"

  # 27. Regression: default "latest" resolution must not leak log output
  # into $BUN_VERSION via command substitution (stdout capture). This path
  # is what unpinned apps hit on every build.
  rm -f "$tmp_app/.bun-version"
  printf 'v%s' "$TEST_BUN_VERSION" > "$tmp_cache/bun-latest-version"
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile resolves default latest version from cache"
  else
    echo "$compile_out"
    fail "compile failed resolving default latest version"
  fi
  if echo "$compile_out" | grep -q "Bun v$TEST_BUN_VERSION (latest)"; then
    pass "latest version string is clean (no stdout pollution)"
  else
    echo "$compile_out"
    fail "latest version string corrupted by captured log output"
  fi
  if ls "$tmp_cache/bun-bin-cache/v$TEST_BUN_VERSION/"*/bun >/dev/null 2>&1; then
    pass "binary cache keyed by clean version string"
  else
    fail "binary cache missing or keyed by corrupted version string"
  fi
fi
unset BUN_BINARY_VARIANT || true

echo "-----> All tests passed"
