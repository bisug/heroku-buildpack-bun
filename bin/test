#!/usr/bin/env bash
# bin/test
# Basic smoke tests for the buildpack - run via: heroku buildpacks:test
# Supported stacks: heroku-22, heroku-24, heroku-26

set -euo pipefail

BP_DIR=$(
  cd "$(dirname "$0")"
  cd ..
  pwd
)

pass() { echo "  PASS: $*"; }
fail() {
  echo "  FAIL: $*" >&2
  exit 1
}

echo "-----> Running buildpack tests"

# Section 1: Sanity checks

# 1. Required scripts are executable
for script in detect compile release; do
  [ -x "$BP_DIR/bin/$script" ] \
    && pass "bin/$script is executable" \
    || fail "bin/$script is not executable"
done

# 2. Required tools present on build dyno
for tool in jq curl unzip bash; do
  command -v "$tool" &>/dev/null \
    && pass "$tool is available" \
    || fail "$tool is required but not found"
done

tmpdirs=()
new_tmp() {
  local _d
  _d=$(mktemp -d)
  tmpdirs+=("$_d")
  printf '%s\n' "$_d"
}
cleanup_test_tmp() { rm -rf "${tmpdirs[@]:-}"; }
trap cleanup_test_tmp EXIT

expect_detect() { # $1=0|1 expected exit, $2=dir, $3=message
  local got
  if "$BP_DIR/bin/detect" "$2" &>/dev/null; then got=0; else got=1; fi
  [ "$got" = "$1" ] && pass "$3" || fail "$3 (want exit $1, got $got)"
}

expect_release_contains() { # $1=dir $2=pattern $3=message
  local out
  out=$("$BP_DIR/bin/release" "$1")
  if echo "$out" | grep -q "$2"; then pass "$3"; else
    echo "$out"
    fail "$3"
  fi
}

# Section 2: Detection tests

# 3. detect rejects a non-Bun directory
tmp_empty=$(new_tmp)
expect_detect 1 "$tmp_empty" "detect correctly rejects non-Bun directory"

# 4. detect rejects a bare package.json (no Bun signals)
tmp_pkg=$(new_tmp)
echo '{}' >"$tmp_pkg/package.json"
expect_detect 1 "$tmp_pkg" "detect correctly rejects bare package.json"

# 5. detect accepts a directory with .bun-version
tmp_bun=$(new_tmp)
echo 'v1.3.13' >"$tmp_bun/.bun-version"
expect_detect 0 "$tmp_bun" "detect correctly accepts directory with .bun-version"

# 6. detect accepts a directory with bun.lock
tmp_lock=$(new_tmp)
echo '{}' >"$tmp_lock/bun.lock"
expect_detect 0 "$tmp_lock" "detect correctly accepts directory with bun.lock"

# 7. detect accepts a directory with bun.lockb (legacy binary lockfile)
tmp_lockb=$(new_tmp)
touch "$tmp_lockb/bun.lockb"
expect_detect 0 "$tmp_lockb" "detect correctly accepts directory with bun.lockb"

# 8. detect accepts package.json with packageManager set to bun
tmp_pm=$(new_tmp)
echo '{"packageManager": "bun@1.2.0"}' >"$tmp_pm/package.json"
expect_detect 0 "$tmp_pm" "detect correctly accepts packageManager=bun"

# 8b. detect accepts packageManager with the bun- prefix
tmp_pm_dash=$(new_tmp)
echo '{"packageManager": "bun-1.2.0"}' >"$tmp_pm_dash/package.json"
expect_detect 0 "$tmp_pm_dash" "detect accepts packageManager=bun-1.2.0"

# 9. detect accepts package.json with engines.bun
tmp_engines=$(new_tmp)
echo '{"engines": {"bun": ">=1.0.0"}}' >"$tmp_engines/package.json"
expect_detect 0 "$tmp_engines" "detect correctly accepts engines.bun"

# 10. detect accepts bunfig.toml
tmp_bunfig=$(new_tmp)
touch "$tmp_bunfig/bunfig.toml"
expect_detect 0 "$tmp_bunfig" "detect correctly accepts bunfig.toml"

# 11. detect rejects package.json with engines.node but no engines.bun
tmp_node=$(new_tmp)
echo '{"engines": {"node": ">=18"}}' >"$tmp_node/package.json"
expect_detect 1 "$tmp_node" "detect correctly rejects engines.node without engines.bun"

# 12. detect rejects non-existent directory
expect_detect 1 "/tmp/this-path-does-not-exist-$$" "detect correctly rejects non-existent directory"

# Section 4: Release script tests

# 19. release outputs web: bun run start for start script
tmp_rel=$(new_tmp)
echo '{"scripts": {"start": "bun run index.js"}}' >"$tmp_rel/package.json"
expect_release_contains "$tmp_rel" "web: bun run start" "release outputs 'web: bun run start' for start script"

# 20. release outputs worker process type
tmp_worker=$(new_tmp)
echo '{"scripts": {"start": "bun run index.js", "worker": "bun run worker.js"}}' >"$tmp_worker/package.json"
expect_release_contains "$tmp_worker" "worker: bun run worker" "release outputs worker process type"

# 21. release prefers 'web' script over 'start'
tmp_web=$(new_tmp)
echo '{"scripts": {"web": "bun serve.js", "start": "bun index.js"}}' >"$tmp_web/package.json"
expect_release_contains "$tmp_web" "web: bun run web" "release prefers 'web' script over 'start'"

# 22. release falls back to entry file when no scripts defined
tmp_entry=$(new_tmp)
echo '{}' >"$tmp_entry/package.json"
echo 'console.log("hello")' >"$tmp_entry/index.ts"
expect_release_contains "$tmp_entry" "web: bun run index.ts" "release falls back to index.ts entry file"

# 22b. Procfile suppresses default_process_types
tmp_proc=$(new_tmp)
echo '{"scripts": {"start": "bun run index.js"}}' >"$tmp_proc/package.json"
echo 'web: bun run server.js' >"$tmp_proc/Procfile"
if release_out=$("$BP_DIR/bin/release" "$tmp_proc"); then
  if echo "$release_out" | grep -q 'default_process_types'; then
    fail "release adds default_process_types when a Procfile exists"
  else
    pass "release omits default_process_types when a Procfile exists"
  fi
else
  fail "release failed with a Procfile"
fi

# 22c. release emits worker, release and scheduler process types
tmp_types=$(new_tmp)
echo '{"scripts": {"worker": "bun w.js", "release": "bun r.js", "scheduler": "bun s.js"}}' >"$tmp_types/package.json"
for pt in worker release scheduler; do
  expect_release_contains "$tmp_types" "$pt: bun run $pt" "release emits $pt process type"
done

# 22d. web script wins and start is not emitted as a second web type
tmp_web_priority=$(new_tmp)
echo '{"scripts": {"web": "bun serve.js", "start": "bun index.js"}}' >"$tmp_web_priority/package.json"
release_out=$("$BP_DIR/bin/release" "$tmp_web_priority")
if echo "$release_out" | grep -q 'web: bun run web' && ! echo "$release_out" | grep -q 'bun run start'; then
  pass "release emits only the web script as the web process"
else
  echo "$release_out"
  fail "release emitted start alongside web"
fi

# 22e. release still emits YAML when package.json is invalid
tmp_badpkg=$(new_tmp)
echo 'not json' >"$tmp_badpkg/package.json"
if release_out=$("$BP_DIR/bin/release" "$tmp_badpkg" 2>&1); then
  echo "$release_out" | grep -q '^---' \
    && pass "release emits YAML for invalid package.json" \
    || fail "release emitted no YAML for invalid package.json"
else
  echo "$release_out"
  fail "release exited nonzero for invalid package.json"
fi

# Section 5: Compile unit tests (no network)

source "$BP_DIR/lib/version.sh"

# 23-24. normalize_bun_version accepts exact forms, rejects ranges
for vcase in "1.3.13:v1.3.13" "v1.3.13:v1.3.13" "bun-v1.3.13:v1.3.13" "bun@1.3.13:v1.3.13" "bun@latest:latest" "latest:latest" "canary:canary" "*:latest" "x:latest"; do
  raw="${vcase%%:*}"
  want="${vcase##*:}"
  got=$(normalize_bun_version "$raw")
  [ "$got" = "$want" ] \
    && pass "normalize_bun_version '$raw' -> '$want'" \
    || fail "normalize_bun_version '$raw' gave '$got', want '$want'"
done
for bad in ">=1.0.0" "^1.3.0" "~1.3.0" "" "abc" "1.3"; do
  if normalize_bun_version "$bad" >/dev/null 2>&1; then
    fail "normalize_bun_version should reject '$bad'"
  else
    pass "normalize_bun_version rejects '$bad'"
  fi
done

for rcase in ">=1.0.0" "^1.3.0" "~1.3.0" "1.3" "bun@^1.0.0" "1.x" "*"; do
  is_bun_version_range "$rcase" \
    && pass "is_bun_version_range '$rcase' is true" \
    || fail "is_bun_version_range '$rcase' should be true"
done
for nonrange in "1.3.13" "v1.3.13" "bun-v1.3.13" "bun@1.3.13" "latest" "canary" "abc" ""; do
  if is_bun_version_range "$nonrange"; then
    fail "is_bun_version_range '$nonrange' should be false"
  else
    pass "is_bun_version_range '$nonrange' is false"
  fi
done

# 24. runtime.txt guard handles foreign values (behavior covered live in #27-28)
expect_grep() { # $1=pattern $2=file $3=message
  grep -q "$1" "$2" && pass "$3" || fail "$3"
}
expect_grep "Ignoring runtime.txt" "$BP_DIR/bin/compile" "compile ignores foreign runtime.txt"
expect_grep "set -f" "$BP_DIR/bin/compile" "BUN_INSTALL_FLAGS split disables globbing"

# 24b. Invalid versions are attributed to the source that supplied them
tmp_unit_env=$(new_tmp)
expect_invalid_source() { # $1=label $2=app dir $3=cache dir $4...=command prefix
  local label="$1" dir="$2" cache="$3" out
  shift 3
  if out=$("$@" "$BP_DIR/bin/compile" "$dir" "$cache" "$tmp_unit_env" 2>&1); then
    echo "$out"
    fail "compile accepted an invalid $label version"
  fi
  echo "$out" | grep -q "Invalid Bun version from $label" \
    && pass "compile names $label as the invalid version source" \
    || { echo "$out"; fail "compile did not name $label as the version source"; }
}

tmp_src_var=$(new_tmp)
expect_invalid_source "BUN_VERSION config var" "$tmp_src_var" "$tmp_src_var" env BUN_VERSION=bad
tmp_src_file=$(new_tmp)
printf 'bad' >"$tmp_src_file/.bun-version"
expect_invalid_source ".bun-version" "$tmp_src_file" "$tmp_src_file" env
tmp_src_engines=$(new_tmp)
echo '{"engines": {"bun": "bad"}}' >"$tmp_src_engines/package.json"
expect_invalid_source "package.json engines.bun" "$tmp_src_engines" "$tmp_src_engines" env
tmp_src_pm=$(new_tmp)
echo '{"packageManager": "bun@bad"}' >"$tmp_src_pm/package.json"
expect_invalid_source "package.json packageManager" "$tmp_src_pm" "$tmp_src_pm" env
tmp_src_runtime=$(new_tmp)
printf 'bad' >"$tmp_src_runtime/runtime.bun.txt"
expect_invalid_source "runtime.bun.txt" "$tmp_src_runtime" "$tmp_src_runtime" env

# 25. ENV_DIR blocklist keeps dangerous variables out of the build environment
source "$BP_DIR/lib/env.sh"
tmp_envdir=$(new_tmp)
for blocked in LD_PRELOAD LD_AUDIT LD_CONFIG PS4 BASH_ENV; do
  printf 'bad' >"$tmp_envdir/$blocked"
done
printf 'ok' >"$tmp_envdir/APP_FLAG"
unset APP_FLAG LD_PRELOAD LD_AUDIT LD_CONFIG PS4 BASH_ENV || true
export_env_dir "$tmp_envdir"
for blocked in LD_PRELOAD LD_AUDIT LD_CONFIG PS4 BASH_ENV; do
  [[ -z "${!blocked:-}" ]] \
    && pass "ENV_DIR does not export $blocked" \
    || fail "ENV_DIR exported blocked variable $blocked"
done
[[ "${APP_FLAG:-}" == "ok" ]] \
  && pass "ENV_DIR exports safe variables" \
  || fail "ENV_DIR did not export APP_FLAG"

# Section 6: Compile + Release integration test

# 26. compile and release integration test (end-to-end)
tmp_app=$(new_tmp)
tmp_cache=$(new_tmp)
tmp_env=$(new_tmp)

# The standard x64 Bun binary requires AVX2 and crashes (SIGILL) on CPUs without
# it (e.g. some low-power Intel/AMD). Use the baseline variant there. We pin a
# recent version whose binary is runnable on CI runners (they have AVX2), which
# also avoids the ancient v1.0.0 binary failing on newer glibc.
if ! grep -qi 'avx2' /proc/cpuinfo 2>/dev/null; then
  export BUN_BINARY_VARIANT="baseline"
fi
TEST_BUN_VERSION="1.3.13"

# Setup a basic bun app
echo '{"scripts": {"start": "bun run index.js"}}' >"$tmp_app/package.json"
echo 'console.log("Hello from tests!")' >"$tmp_app/index.js"
echo "v$TEST_BUN_VERSION" >"$tmp_app/.bun-version"

# Skip the network-dependent compile test when we can't reach GitHub.
if ! curl -fsSI --max-time 10 \
  "https://github.com/oven-sh/bun/releases/download/bun-v${TEST_BUN_VERSION}/bun-linux-x64.zip" >/dev/null 2>&1; then
  if [[ "${BUN_TEST_REQUIRE_NETWORK:-}" == "1" ]]; then
    fail "compile integration test requires network access to GitHub"
  fi
  echo "  SKIP: compile integration test (no network access to GitHub)"
else
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile successfully builds a basic app"
  else
    echo "$compile_out"
    fail "compile failed on a basic app"
  fi

  expect_release_contains "$tmp_app" "web: bun run start" "release outputs correct web process type"

  # 26b. A version pin without a trailing newline must still resolve
  printf 'v%s' "$TEST_BUN_VERSION" >"$tmp_app/.bun-version"
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile accepts a version pin without a trailing newline"
  else
    echo "$compile_out"
    fail "compile rejected a version pin without a trailing newline"
  fi

  # 26c. A bun.lock app with an unrelated packageManager must not abort
  printf 'v%s\n' "$TEST_BUN_VERSION" >"$tmp_cache/bun-latest-version"
  rm -f "$tmp_app/.bun-version"
  echo '{"packageManager": "bundle@1.0.0", "scripts": {"start": "bun run index.js"}}' >"$tmp_app/package.json"
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    if echo "$compile_out" | grep -q "Invalid Bun version"; then
      echo "$compile_out"
      fail "compile treated an unrelated packageManager as a Bun version"
    else
      pass "compile ignores an unrelated packageManager value"
    fi
  else
    echo "$compile_out"
    fail "compile aborted on an unrelated packageManager value"
  fi

  # 26d. Cached binary must match the requested version
  tmp_badcache=$(new_tmp)
  case "$(uname -m)" in
    x86_64)
      artifact="bun-linux-x64"
      if [[ "${BUN_BINARY_VARIANT:-}" == "baseline" ]]; then artifact="bun-linux-x64-baseline"; fi
      ;;
    *) artifact="bun-linux-aarch64" ;;
  esac
  mkdir -p "$tmp_badcache/bun-bin-cache/v$TEST_BUN_VERSION/$artifact"
  printf '#!/bin/sh\necho v0.0.0\n' >"$tmp_badcache/bun-bin-cache/v$TEST_BUN_VERSION/$artifact/bun"
  chmod +x "$tmp_badcache/bun-bin-cache/v$TEST_BUN_VERSION/$artifact/bun"
  rm -f "$tmp_app/bun.lock"
  echo '{"scripts": {"start": "bun run index.js"}}' >"$tmp_app/package.json"
  echo "v$TEST_BUN_VERSION" >"$tmp_app/.bun-version"
  compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_badcache" "$tmp_env" 2>&1)
  if echo "$compile_out" | grep -q "Cached Bun binary is invalid"; then
    pass "compile rejects a cached binary with the wrong version"
  else
    echo "$compile_out"
    fail "compile accepted a cached binary with the wrong version"
  fi

  # 26e. A production build hook runs through pkg_has_script
  echo '{"scripts": {"start": "bun run index.js", "heroku-prebuild": "touch prebuilt-marker"}}' >"$tmp_app/package.json"
  rm -f "$tmp_app/prebuilt-marker"
  compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1)
  [[ -f "$tmp_app/prebuilt-marker" ]] \
    && pass "compile runs heroku-prebuild through pkg_has_script" \
    || fail "compile did not run heroku-prebuild"

  # 27. Regression: default "latest" resolution must not leak log output
  # into $BUN_VERSION via command substitution (stdout capture). This path
  # is what unpinned apps hit on every build.
  rm -f "$tmp_app/.bun-version"
  printf 'v%s' "$TEST_BUN_VERSION" >"$tmp_cache/bun-latest-version"
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile resolves default latest version from cache"
  else
    echo "$compile_out"
    fail "compile failed resolving default latest version"
  fi
  if echo "$compile_out" | grep -q "Bun v$TEST_BUN_VERSION (latest)"; then
    pass "latest version string is clean (no stdout pollution)"
  else
    echo "$compile_out"
    fail "latest version string corrupted by captured log output"
  fi
  if ls "$tmp_cache/bun-bin-cache/v$TEST_BUN_VERSION/"*/bun >/dev/null 2>&1; then
    pass "binary cache keyed by clean version string"
  else
    fail "binary cache missing or keyed by corrupted version string"
  fi

  # 28. Semver range in engines.bun falls back to latest with warning
  echo '{"engines": {"bun": "^1.0.0"}, "scripts": {"start": "bun run index.js"}}' >"$tmp_app/package.json"
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile succeeds with semver range in engines.bun"
  else
    echo "$compile_out"
    fail "compile failed on semver range in engines.bun"
  fi
  if echo "$compile_out" | grep -q "falling back to 'latest'"; then
    pass "compile warned about semver range fallback to latest"
  else
    echo "$compile_out"
    fail "compile did not warn about semver range fallback"
  fi

  # 29. packageManager field in package.json is used for version resolution
  echo '{"packageManager": "bun@'"$TEST_BUN_VERSION"'", "scripts": {"start": "bun run index.js"}}' >"$tmp_app/package.json"
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile succeeds with packageManager in package.json"
  else
    echo "$compile_out"
    fail "compile failed with packageManager in package.json"
  fi
  if echo "$compile_out" | grep -q "Using Bun version from package.json packageManager"; then
    pass "compile resolved version from packageManager"
  else
    echo "$compile_out"
    fail "compile did not resolve version from packageManager"
  fi
fi
unset BUN_BINARY_VARIANT || true

echo "-----> All tests passed"
