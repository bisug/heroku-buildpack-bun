#!/usr/bin/env bash
# bin/test
# Basic smoke tests for the buildpack - run via: heroku buildpacks:test
# Supported stacks: heroku-22, heroku-24, heroku-26

set -euo pipefail

BP_DIR=$(cd "$(dirname "$0")"; cd ..; pwd)

pass() { echo "  PASS: $*"; }
fail() { echo "  FAIL: $*" >&2; exit 1; }

echo "-----> Running buildpack tests"

# Section 1: Sanity checks

# 1. Required scripts are executable
for script in detect compile release; do
  if [ -x "$BP_DIR/bin/$script" ]; then
    pass "bin/$script is executable"
  else
    fail "bin/$script is not executable"
  fi
done

# 2. Required tools present on build dyno
for tool in jq curl unzip bash; do
  if command -v "$tool" &>/dev/null; then
    pass "$tool is available"
  else
    fail "$tool is required but not found"
  fi
done

# Section 2: Detection tests

# 3. detect rejects a non-Bun directory
tmp_empty=$(mktemp -d)
if "$BP_DIR/bin/detect" "$tmp_empty" &>/dev/null; then
  fail "detect should have rejected an empty directory"
else
  pass "detect correctly rejects non-Bun directory"
fi
rm -rf "$tmp_empty"

# 4. detect rejects a bare package.json (no Bun signals)
tmp_pkg=$(mktemp -d)
echo '{}' > "$tmp_pkg/package.json"
if "$BP_DIR/bin/detect" "$tmp_pkg" &>/dev/null; then
  fail "detect should have rejected bare package.json (no Bun signals)"
else
  pass "detect correctly rejects bare package.json"
fi
rm -rf "$tmp_pkg"

# 5. detect accepts a directory with .bun-version
tmp_bun=$(mktemp -d)
echo 'v1.3.13' > "$tmp_bun/.bun-version"
if "$BP_DIR/bin/detect" "$tmp_bun" &>/dev/null; then
  pass "detect correctly accepts directory with .bun-version"
else
  fail "detect should have accepted directory with .bun-version"
fi
rm -rf "$tmp_bun"

# 6. detect accepts a directory with bun.lock
tmp_lock=$(mktemp -d)
echo '{}' > "$tmp_lock/bun.lock"
if "$BP_DIR/bin/detect" "$tmp_lock" &>/dev/null; then
  pass "detect correctly accepts directory with bun.lock"
else
  fail "detect should have accepted directory with bun.lock"
fi
rm -rf "$tmp_lock"

# 7. detect accepts a directory with bun.lockb (legacy binary lockfile)
tmp_lockb=$(mktemp -d)
touch "$tmp_lockb/bun.lockb"
if "$BP_DIR/bin/detect" "$tmp_lockb" &>/dev/null; then
  pass "detect correctly accepts directory with bun.lockb"
else
  fail "detect should have accepted directory with bun.lockb"
fi
rm -rf "$tmp_lockb"

# 8. detect accepts package.json with packageManager set to bun
tmp_pm=$(mktemp -d)
echo '{"packageManager": "bun@1.2.0"}' > "$tmp_pm/package.json"
if "$BP_DIR/bin/detect" "$tmp_pm" &>/dev/null; then
  pass "detect correctly accepts packageManager=bun"
else
  fail "detect should have accepted packageManager=bun"
fi
rm -rf "$tmp_pm"

# 9. detect accepts package.json with engines.bun
tmp_engines=$(mktemp -d)
echo '{"engines": {"bun": ">=1.0.0"}}' > "$tmp_engines/package.json"
if "$BP_DIR/bin/detect" "$tmp_engines" &>/dev/null; then
  pass "detect correctly accepts engines.bun"
else
  fail "detect should have accepted engines.bun"
fi
rm -rf "$tmp_engines"

# 10. detect accepts bunfig.toml
tmp_bunfig=$(mktemp -d)
touch "$tmp_bunfig/bunfig.toml"
if "$BP_DIR/bin/detect" "$tmp_bunfig" &>/dev/null; then
  pass "detect correctly accepts bunfig.toml"
else
  fail "detect should have accepted bunfig.toml"
fi
rm -rf "$tmp_bunfig"

# 11. detect rejects package.json with engines.node but no engines.bun
tmp_node=$(mktemp -d)
echo '{"engines": {"node": ">=18"}}' > "$tmp_node/package.json"
if "$BP_DIR/bin/detect" "$tmp_node" &>/dev/null; then
  fail "detect should have rejected engines.node without engines.bun"
else
  pass "detect correctly rejects engines.node without engines.bun"
fi
rm -rf "$tmp_node"

# 12. detect rejects non-existent directory
if "$BP_DIR/bin/detect" "/tmp/this-path-does-not-exist-$$" &>/dev/null; then
  fail "detect should have rejected non-existent directory"
else
  pass "detect correctly rejects non-existent directory"
fi

# Section 3: JSON helper tests

source "$BP_DIR/lib/json.sh"

# 13. has_script returns true for existing script
tmp_json=$(mktemp -d)
echo '{"scripts": {"start": "bun index.js", "build": "bun build"}}' > "$tmp_json/package.json"
if [[ "$(has_script "$tmp_json/package.json" "start")" == "true" ]]; then
  pass "has_script finds existing script"
else
  fail "has_script should find 'start' script"
fi

# 14. has_script returns false for missing script
if [[ "$(has_script "$tmp_json/package.json" "nonexistent")" == "false" ]]; then
  pass "has_script returns false for missing script"
else
  fail "has_script should return false for missing 'nonexistent' script"
fi

# 15. has_script returns false when scripts is missing
echo '{}' > "$tmp_json/no-scripts.json"
if [[ "$(has_script "$tmp_json/no-scripts.json" "start")" == "false" ]]; then
  pass "has_script returns false when scripts is missing"
else
  fail "has_script should return false when scripts is missing"
fi

# 16. has_script returns false when scripts is not an object
echo '{"scripts": null}' > "$tmp_json/null-scripts.json"
if [[ "$(has_script "$tmp_json/null-scripts.json" "start")" == "false" ]]; then
  pass "has_script returns false when scripts is null"
else
  fail "has_script should return false when scripts is null"
fi

# 17. is_invalid_json_file detects invalid JSON
echo 'not valid json{' > "$tmp_json/bad.json"
if [[ "$(is_invalid_json_file "$tmp_json/bad.json")" == "true" ]]; then
  pass "is_invalid_json_file correctly detects invalid JSON"
else
  fail "is_invalid_json_file should detect invalid JSON"
fi

# 18. is_invalid_json_file passes valid JSON
if [[ "$(is_invalid_json_file "$tmp_json/package.json")" == "false" ]]; then
  pass "is_invalid_json_file correctly passes valid JSON"
else
  fail "is_invalid_json_file should pass valid JSON"
fi
rm -rf "$tmp_json"

# Section 4: Release script tests

# 19. release outputs web: bun run start for start script
tmp_rel=$(mktemp -d)
echo '{"scripts": {"start": "bun run index.js"}}' > "$tmp_rel/package.json"
release_out=$("$BP_DIR/bin/release" "$tmp_rel")
if echo "$release_out" | grep -q "web: bun run start"; then
  pass "release outputs 'web: bun run start' for start script"
else
  echo "$release_out"
  fail "release output missing 'web: bun run start'"
fi
rm -rf "$tmp_rel"

# 20. release outputs worker process type
tmp_worker=$(mktemp -d)
echo '{"scripts": {"start": "bun run index.js", "worker": "bun run worker.js"}}' > "$tmp_worker/package.json"
release_out=$("$BP_DIR/bin/release" "$tmp_worker")
if echo "$release_out" | grep -q "worker: bun run worker"; then
  pass "release outputs worker process type"
else
  echo "$release_out"
  fail "release output missing 'worker: bun run worker'"
fi
rm -rf "$tmp_worker"

# 21. release prefers 'web' script over 'start'
tmp_web=$(mktemp -d)
echo '{"scripts": {"web": "bun serve.js", "start": "bun index.js"}}' > "$tmp_web/package.json"
release_out=$("$BP_DIR/bin/release" "$tmp_web")
if echo "$release_out" | grep -q "web: bun run web"; then
  pass "release prefers 'web' script over 'start'"
else
  echo "$release_out"
  fail "release should prefer 'web' script over 'start'"
fi
rm -rf "$tmp_web"

# 22. release falls back to entry file when no scripts defined
tmp_entry=$(mktemp -d)
echo '{}' > "$tmp_entry/package.json"
echo 'console.log("hello")' > "$tmp_entry/index.ts"
release_out=$("$BP_DIR/bin/release" "$tmp_entry")
if echo "$release_out" | grep -q "web: bun run index.ts"; then
  pass "release falls back to index.ts entry file"
else
  echo "$release_out"
  fail "release should fall back to 'web: bun run index.ts'"
fi
rm -rf "$tmp_entry"

# Section 5: Compile + Release integration test

# 23. compile and release integration test (end-to-end)
tmp_app=$(mktemp -d)
tmp_cache=$(mktemp -d)
tmp_env=$(mktemp -d)

# The standard x64 Bun binary requires AVX2 and crashes (SIGILL) on CPUs without
# it (e.g. some low-power Intel/AMD). Use the baseline variant there. We pin a
# recent version whose binary is runnable on CI runners (they have AVX2), which
# also avoids the ancient v1.0.0 binary failing on newer glibc.
if ! grep -qi 'avx2' /proc/cpuinfo 2>/dev/null; then
  export BUN_BINARY_VARIANT="baseline"
fi
TEST_BUN_VERSION="1.3.13"

# Setup a basic bun app
echo '{"scripts": {"start": "bun run index.js"}}' > "$tmp_app/package.json"
echo 'console.log("Hello from tests!")' > "$tmp_app/index.js"
echo "v$TEST_BUN_VERSION" > "$tmp_app/.bun-version"

# Skip the network-dependent compile test when we can't reach GitHub.
if ! curl -fsSI --max-time 10 >/dev/null 2>&1 \
     "https://github.com/oven-sh/bun/releases/download/bun-v${TEST_BUN_VERSION}/bun-linux-x64.zip"; then
  echo "  SKIP: compile integration test (no network access to GitHub)"
  unset BUN_BINARY_VARIANT
  rm -rf "$tmp_app" "$tmp_cache" "$tmp_env"
else
  # Run compile and capture output to prevent spamming the console, but save it in case of error
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile successfully builds a basic app"
  else
    echo "$compile_out"
    fail "compile failed on a basic app"
  fi

  # Run release and check YAML
  release_out=$("$BP_DIR/bin/release" "$tmp_app")
  if echo "$release_out" | grep -q "web: bun run start"; then
    pass "release outputs correct web process type"
  else
    echo "$release_out"
    fail "release output missing 'web: bun run start'"
  fi

  # 24. Regression: default "latest" resolution must not leak log output
  # into $BUN_VERSION via command substitution (stdout capture). This path
  # is what unpinned apps hit on every build.
  rm -f "$tmp_app/.bun-version"
  printf 'v%s' "$TEST_BUN_VERSION" > "$tmp_cache/bun-latest-version"
  if compile_out=$("$BP_DIR/bin/compile" "$tmp_app" "$tmp_cache" "$tmp_env" 2>&1); then
    pass "compile resolves default latest version from cache"
  else
    echo "$compile_out"
    fail "compile failed resolving default latest version"
  fi
  if echo "$compile_out" | grep -q "Bun v$TEST_BUN_VERSION (latest)"; then
    pass "latest version string is clean (no stdout pollution)"
  else
    echo "$compile_out"
    fail "latest version string corrupted by captured log output"
  fi
  if ls "$tmp_cache/bun-bin-cache/v$TEST_BUN_VERSION/"*/bun >/dev/null 2>&1; then
    pass "binary cache keyed by clean version string"
  else
    fail "binary cache missing or keyed by corrupted version string"
  fi

  unset BUN_BINARY_VARIANT
  rm -rf "$tmp_app" "$tmp_cache" "$tmp_env"
fi

echo "-----> All tests passed"
