#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>
# $HOME: /app

set -euo pipefail

puts_header() { echo "-----> $*"; }
puts_step()   { echo "       $*"; }
puts_warn()   { echo " !     $*" >&2; }

on_error() {
  local exit_code=$?
  local line="${1:-unknown}"
  puts_warn "Build failed near line ${line} (exit code ${exit_code})."
  puts_warn "If this looks like a buildpack bug, please open an issue:"
  puts_warn "https://github.com/bisug/heroku-buildpack-bun/issues"
  exit "$exit_code"
}
trap 'on_error "$LINENO"' ERR

BUILD_DIR="${1:-}"
CACHE_DIR="${2:-}"
ENV_DIR="${3:-}"
BP_DIR=$(cd "$(dirname "$0")"; cd ..; pwd)

if [[ -z "$BUILD_DIR" || ! -d "$BUILD_DIR" ]]; then
  puts_warn "Usage: bin/compile BUILD_DIR CACHE_DIR ENV_DIR"
  exit 1
fi

source "$BP_DIR/lib/json.sh"

missing_tools=()
for tool in curl jq unzip; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    missing_tools+=("$tool")
  fi
done

if (( ${#missing_tools[@]} > 0 )); then
  puts_warn "Missing required tool(s): ${missing_tools[*]}"
  puts_warn "This buildpack supports the Heroku common runtime stacks where these tools are available."
  exit 1
fi

cd "$BUILD_DIR"

HEROKU_DIR="$BUILD_DIR/.heroku"
mkdir -p "$HEROKU_DIR/bin"
if [[ -n "$CACHE_DIR" ]]; then
  mkdir -p "$CACHE_DIR"
fi

# Keep the buildpack export script deterministic for multi-buildpack builds.
: > "$BP_DIR/export"

cleanup_paths=()
cleanup() {
  local path
  for path in "${cleanup_paths[@]:-}"; do
    if [[ -n "$path" ]]; then
      rm -rf "$path"
    fi
  done
}
trap cleanup EXIT

skip_requested() {
  local env_name="$1"
  local marker_file="$2"
  [[ -f "$marker_file" ]] && return 0
  case "${!env_name:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
  esac
  return 1
}

shell_quote() {
  printf "%q" "$1"
}

export_env_dir() {
  local env_dir="$1"
  local entry key

  [[ -d "$env_dir" ]] || return 0

  for entry in "$env_dir/"*; do
    [[ -f "$entry" ]] || continue
    key=$(basename "$entry")

    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      puts_warn "Skipping invalid config var name from ENV_DIR: $key"
      continue
    fi

    case "$key" in
      PATH|HOME|IFS|GIT_DIR|CPATH|CPPATH|LD_PRELOAD|LIBRARY_PATH|LD_LIBRARY_PATH|BASH_ENV|ENV|SHELLOPTS|BUILDPACK_URL|SOURCE_VERSION)
        continue
        ;;
    esac

    export "$key=$(cat "$entry")"
  done
}

normalize_bun_version() {
  local raw="$1"

  raw=$(printf "%s" "$raw" | tr -d '[:space:]')
  case "$raw" in
    "") return 1 ;;
    latest|canary)
      printf "%s\n" "$raw"
      return 0
      ;;
    bun-v*|bun-[0-9]*)
      raw="${raw#bun-}"
      ;;
  esac

  if [[ "$raw" =~ ^[0-9] ]]; then
    raw="v${raw}"
  fi

  if [[ "$raw" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]]; then
    printf "%s\n" "$raw"
    return 0
  fi

  return 1
}

resolve_latest_bun_version() {
  local latest_cache_file="${CACHE_DIR:+$CACHE_DIR/bun-latest-version}"
  local cache_ttl="${BUN_LATEST_TTL_SECONDS:-3600}"
  local cache_age resolved tag

  if [[ ! "$cache_ttl" =~ ^[0-9]+$ ]]; then
    puts_warn "Invalid BUN_LATEST_TTL_SECONDS value: $cache_ttl"
    exit 1
  fi

  if [[ -n "$latest_cache_file" && -f "$latest_cache_file" ]]; then
    cache_age=$(( $(date +%s) - $(date -r "$latest_cache_file" +%s 2>/dev/null || echo "0") ))
    if (( cache_age < cache_ttl )); then
      resolved=$(tr -d '[:space:]' < "$latest_cache_file")
      if resolved=$(normalize_bun_version "$resolved"); then
        # This function's stdout is captured by the caller via $( ); log
        # lines MUST go to stderr or they corrupt the returned version.
        puts_step "Using cached latest Bun version: $resolved" >&2
        printf "%s\n" "$resolved"
        return 0
      fi
    fi
  fi

  # stdout of this function is captured by the caller; logs go to stderr.
  puts_step "Resolving latest Bun version from GitHub..." >&2
  tag=$(curl -fsSL \
    --connect-timeout 10 \
    --max-time 30 \
    --retry 3 \
    --retry-delay 2 \
    "https://api.github.com/repos/oven-sh/bun/releases/latest" \
    | jq -er '.tag_name' 2>/dev/null || true)

  if [[ -n "$tag" ]] && resolved=$(normalize_bun_version "$tag"); then
    if [[ -n "$latest_cache_file" ]]; then
      printf "%s\n" "$resolved" > "$latest_cache_file"
    fi
    printf "%s\n" "$resolved"
    return 0
  fi

  if [[ -n "$latest_cache_file" && -f "$latest_cache_file" ]]; then
    resolved=$(tr -d '[:space:]' < "$latest_cache_file")
    if resolved=$(normalize_bun_version "$resolved"); then
      puts_warn "Could not refresh latest Bun version; using stale cached value: $resolved"
      printf "%s\n" "$resolved"
      return 0
    fi
  fi

  puts_warn "Unable to resolve the latest Bun version from GitHub."
  puts_warn "Pin BUN_VERSION, .bun-version, runtime.bun.txt, or package.json engines.bun to an exact version."
  exit 1
}

run_package_script() {
  local script_name="$1"
  local label="$2"
  local env_skip="$3"
  local file_skip="$4"

  if [[ -f "package.json" && "$(has_script "package.json" "$script_name")" == "true" ]]; then
    if skip_requested "$env_skip" "$file_skip"; then
      puts_step "Skipping $script_name."
      return 0
    fi

    puts_step "$label..."
    bun run "$script_name"
  fi
}

export_env_dir "$ENV_DIR"

export NODE_ENV="${NODE_ENV:-production}"
puts_step "NODE_ENV is set to $NODE_ENV"

if [[ -f "package.json" && "$(is_invalid_json_file "package.json")" == "true" ]]; then
  puts_warn "package.json contains invalid JSON."
  exit 1
fi

BUN_VERSION_RAW=""
BUN_VERSION_SOURCE="default"

if [[ -n "${BUN_VERSION:-}" ]]; then
  BUN_VERSION_RAW="$BUN_VERSION"
  BUN_VERSION_SOURCE="BUN_VERSION config var"
elif [[ -f ".bun-version" ]]; then
  BUN_VERSION_RAW=$(cat ".bun-version")
  BUN_VERSION_SOURCE=".bun-version"
elif [[ -f "package.json" ]] && jq -e '.engines? | objects | has("bun")' "package.json" >/dev/null 2>&1; then
  BUN_VERSION_RAW=$(jq -r '.engines.bun' "package.json")
  BUN_VERSION_SOURCE="package.json engines.bun"
elif [[ -f "runtime.bun.txt" ]]; then
  BUN_VERSION_RAW=$(cat "runtime.bun.txt")
  BUN_VERSION_SOURCE="runtime.bun.txt"
elif [[ -f "runtime.txt" ]]; then
  runtime_value=$(tr -d '[:space:]' < "runtime.txt")
  if [[ "$runtime_value" =~ ^([0-9]|v[0-9]|bun-) ]]; then
    BUN_VERSION_RAW="$runtime_value"
    BUN_VERSION_SOURCE="runtime.txt"
  fi
fi

if [[ -z "$BUN_VERSION_RAW" ]]; then
  BUN_VERSION_RAW="latest"
fi

if ! BUN_VERSION=$(normalize_bun_version "$BUN_VERSION_RAW"); then
  puts_warn "Invalid Bun version from $BUN_VERSION_SOURCE: $BUN_VERSION_RAW"
  puts_warn "Use latest, canary, or an exact version like 1.3.13, v1.3.13, or bun-v1.3.13."
  puts_warn "Semver ranges such as >=1.0.0 and ^1.3.0 are not supported."
  exit 1
fi

if [[ "$BUN_VERSION" == "latest" ]]; then
  BUN_VERSION=$(resolve_latest_bun_version)
  puts_header "Bun $BUN_VERSION (latest)"
elif [[ "$BUN_VERSION" == "canary" ]]; then
  puts_header "Bun canary"
else
  puts_header "Bun $BUN_VERSION"
  puts_step "Using Bun version from $BUN_VERSION_SOURCE."
fi

export BUN_INSTALL="$HEROKU_DIR"

if [[ -n "$CACHE_DIR" ]]; then
  export BUN_INSTALL_CACHE_DIR="$CACHE_DIR/bun-pkg-cache"
else
  export BUN_INSTALL_CACHE_DIR="$HEROKU_DIR/bun-pkg-cache"
fi

if [[ -d "$BUN_INSTALL_CACHE_DIR" ]]; then
  cache_size=$(du -sm "$BUN_INSTALL_CACHE_DIR" 2>/dev/null | cut -f1 || echo "0")
  if [[ "$cache_size" =~ ^[0-9]+$ && "$cache_size" -gt 800 ]]; then
    puts_warn "Bun package cache exceeded 800MB. Clearing to prevent Heroku cache bloat."
    rm -rf "$BUN_INSTALL_CACHE_DIR"
  fi
fi
mkdir -p "$BUN_INSTALL_CACHE_DIR"

ARCH=$(uname -m)
BUN_BINARY_VARIANT="${BUN_BINARY_VARIANT:-standard}"
case "$BUN_BINARY_VARIANT" in
  standard|"") BUN_BINARY_VARIANT="standard" ;;
  baseline) ;;
  *)
    puts_warn "Invalid BUN_BINARY_VARIANT value: $BUN_BINARY_VARIANT"
    puts_warn "Supported values: standard, baseline"
    exit 1
    ;;
esac

case "$ARCH" in
  x86_64)
    if [[ "$BUN_BINARY_VARIANT" == "baseline" ]]; then
      BUN_ARTIFACT_BASE="bun-linux-x64-baseline"
    else
      BUN_ARTIFACT_BASE="bun-linux-x64"
    fi
    ;;
  aarch64|arm64)
    if [[ "$BUN_BINARY_VARIANT" == "baseline" ]]; then
      puts_warn "BUN_BINARY_VARIANT=baseline is only available for x64."
      exit 1
    fi
    BUN_ARTIFACT_BASE="bun-linux-aarch64"
    ;;
  *)
    puts_warn "Unsupported architecture: $ARCH"
    exit 1
    ;;
esac

if [[ "$BUN_VERSION" == "canary" ]]; then
  BUN_CACHEABLE_BINARY="false"
else
  BUN_CACHEABLE_BINARY="true"
fi

download_bun() {
  local bun_zip bun_extract_dir http_code bun_arch bun_release_tag bun_artifact

  case "$ARCH" in
    x86_64) bun_arch="x64" ;;
    aarch64|arm64) bun_arch="aarch64" ;;
  esac

  if [[ "$BUN_VERSION" == "canary" ]]; then
    bun_release_tag="canary"
  else
    bun_release_tag="bun-${BUN_VERSION}"
  fi
  bun_artifact="${BUN_ARTIFACT_BASE}.zip"

  puts_step "Downloading Bun $BUN_VERSION for linux-${bun_arch} (${BUN_BINARY_VARIANT})..."
  bun_zip=$(mktemp)
  bun_extract_dir=$(mktemp -d)
  cleanup_paths+=("$bun_zip" "$bun_extract_dir")

  http_code=$(curl -fsSL \
    --connect-timeout 10 \
    --max-time 120 \
    --retry 3 \
    --retry-delay 2 \
    --retry-connrefused \
    -w "%{http_code}" \
    -o "$bun_zip" \
    "https://github.com/oven-sh/bun/releases/download/${bun_release_tag}/${bun_artifact}" 2>/dev/null || true)

  if [[ "$http_code" != "200" || ! -s "$bun_zip" ]]; then
    puts_warn "Failed to download Bun $BUN_VERSION (HTTP ${http_code:-unknown})."
    puts_warn "URL: https://github.com/oven-sh/bun/releases/download/${bun_release_tag}/${bun_artifact}"
    puts_warn "Verify the version and binary variant exist: https://github.com/oven-sh/bun/releases"
    exit 1
  fi

  if command -v file >/dev/null 2>&1; then
    if ! file "$bun_zip" | grep -qi "zip"; then
      puts_warn "Downloaded file is not a zip archive."
      exit 1
    fi
  elif ! unzip -tq "$bun_zip" >/dev/null 2>&1; then
    puts_warn "Downloaded file is not a valid zip archive."
    exit 1
  fi

  unzip -qo "$bun_zip" -d "$bun_extract_dir"

  if [[ ! -f "$bun_extract_dir/$BUN_ARTIFACT_BASE/bun" ]]; then
    puts_warn "Unexpected archive structure; could not find bun binary."
    puts_warn "Expected: $BUN_ARTIFACT_BASE/bun"
    exit 1
  fi

  cp "$bun_extract_dir/$BUN_ARTIFACT_BASE/bun" "$BUN_INSTALL/bin/bun"
  chmod +x "$BUN_INSTALL/bin/bun"

  # Verify the freshly-downloaded binary actually runs. The standard x64 build
  # requires AVX2; on older CPUs it dies with SIGILL. Catch that here, near the
  # download, instead of letting `bun install` fail later with a cryptic error.
  if ! "$BUN_INSTALL/bin/bun" --version >/dev/null 2>&1; then
    puts_warn "Downloaded Bun binary is not runnable on this system."
    puts_warn "On CPUs without AVX2, set BUN_BINARY_VARIANT=baseline."
    exit 1
  fi
}

prune_binary_cache() {
  local version_dir artifact_dir version_name artifact_name

  [[ -n "$CACHE_DIR" && -d "$CACHE_DIR/bun-bin-cache" ]] || return 0

  for version_dir in "$CACHE_DIR/bun-bin-cache/"*; do
    [[ -d "$version_dir" ]] || continue
    version_name=$(basename "$version_dir")
    if [[ "$version_name" != "$BUN_VERSION" ]]; then
      rm -rf "$version_dir"
    fi
  done

  [[ -d "$CACHE_DIR/bun-bin-cache/$BUN_VERSION" ]] || return 0
  for artifact_dir in "$CACHE_DIR/bun-bin-cache/$BUN_VERSION/"*; do
    [[ -d "$artifact_dir" ]] || continue
    artifact_name=$(basename "$artifact_dir")
    if [[ "$artifact_name" != "$BUN_ARTIFACT_BASE" ]]; then
      rm -rf "$artifact_dir"
    fi
  done
}

BINARY_CACHE_DIR="${CACHE_DIR:+$CACHE_DIR/bun-bin-cache/$BUN_VERSION/$BUN_ARTIFACT_BASE}"
restored_binary="false"

if [[ "$BUN_CACHEABLE_BINARY" == "true" && -n "$BINARY_CACHE_DIR" && -x "$BINARY_CACHE_DIR/bun" ]]; then
  puts_step "Restoring Bun $BUN_VERSION ($BUN_ARTIFACT_BASE) from cache..."
  cp "$BINARY_CACHE_DIR/bun" "$BUN_INSTALL/bin/bun"
  chmod +x "$BUN_INSTALL/bin/bun"
  restored_binary="true"

  if ! "$BUN_INSTALL/bin/bun" --version >/dev/null 2>&1; then
    puts_warn "Cached Bun binary is invalid. Re-downloading."
    rm -rf "$BINARY_CACHE_DIR"
    rm -f "$BUN_INSTALL/bin/bun"
    restored_binary="false"
  fi
fi

if [[ "$restored_binary" != "true" ]]; then
  download_bun

  if [[ "$BUN_CACHEABLE_BINARY" == "true" && -n "$BINARY_CACHE_DIR" ]]; then
    prune_binary_cache
    mkdir -p "$BINARY_CACHE_DIR"
    cp "$BUN_INSTALL/bin/bun" "$BINARY_CACHE_DIR/bun"
  fi
fi

export PATH="$BUN_INSTALL/bin:$PATH"
puts_step "Installed Bun $(bun --version)"

NODE_ENV_QUOTED=$(shell_quote "$NODE_ENV")
BUILD_BIN_QUOTED=$(shell_quote "$BUILD_DIR/.heroku/bin")
BUILD_HEROKU_QUOTED=$(shell_quote "$BUILD_DIR/.heroku")
BUN_CACHE_QUOTED=$(shell_quote "$BUN_INSTALL_CACHE_DIR")

PROFILE_PATH="$BUILD_DIR/.profile.d/bun.sh"
mkdir -p "$(dirname "$PROFILE_PATH")"
{
  echo "export PATH=\"\$HOME/.heroku/bin:\$PATH\""
  echo "export BUN_INSTALL=\"\$HOME/.heroku\""
  echo "export BUN_INSTALL_CACHE_DIR=\"\${BUN_INSTALL_CACHE_DIR:-\$HOME/.heroku/bun-pkg-cache}\""
  echo "if [ -z \"\${NODE_ENV:-}\" ]; then"
  echo "  export NODE_ENV=$NODE_ENV_QUOTED"
  echo "fi"
} > "$PROFILE_PATH"

{
  echo '#!/usr/bin/env bash'
  echo "export PATH=$BUILD_BIN_QUOTED:\$PATH"
  echo "export BUN_INSTALL=$BUILD_HEROKU_QUOTED"
  echo "export BUN_INSTALL_CACHE_DIR=$BUN_CACHE_QUOTED"
  echo "if [ -z \"\${NODE_ENV:-}\" ]; then"
  echo "  export NODE_ENV=$NODE_ENV_QUOTED"
  echo "fi"
} > "$BP_DIR/export"
chmod +x "$BP_DIR/export" 2>/dev/null || true

run_package_script "heroku-prebuild" "Running heroku-prebuild" "BUN_SKIP_HEROKU_PREBUILD" ".skip-bun-heroku-prebuild"

if [[ -f "package.json" ]]; then
  if skip_requested "BUN_SKIP_INSTALL" ".skip-bun-install"; then
    puts_step "Skipping bun install."
  else
    install_args=(install)
    if [[ -f "bun.lock" || -f "bun.lockb" ]]; then
      install_args+=(--frozen-lockfile)
    else
      puts_warn "No lockfile found; running bun install without --frozen-lockfile."
    fi

    if [[ -n "${BUN_INSTALL_FLAGS:-}" ]]; then
      read -r -a extra_install_args <<< "$BUN_INSTALL_FLAGS"
      install_args+=("${extra_install_args[@]}")
    fi

    puts_step "Installing dependencies..."
    if ! bun "${install_args[@]}"; then
      if [[ -f "bun.lock" || -f "bun.lockb" ]]; then
        puts_warn "Dependency install failed with --frozen-lockfile."
        puts_warn "If your lockfile is out of date, run 'bun install' locally and commit the updated lockfile."
      fi
      exit 1
    fi
  fi
fi

run_package_script "build" "Building application" "BUN_SKIP_BUILD" ".skip-bun-build"
run_package_script "heroku-postbuild" "Running heroku-postbuild" "BUN_SKIP_HEROKU_POSTBUILD" ".skip-bun-heroku-postbuild"
