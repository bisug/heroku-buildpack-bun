# Enforce Unix LF line endings for all shell scripts.
# Prevents CRLF corruption on Windows from breaking execution on Heroku Linux dynos.
.gitattributes text eol=lf
Makefile     text eol=lf
bin/*        text eol=lf
lib/*.sh     text eol=lf
CODEOWNERS   text eol=lf

# Documentation files
*.md         text eol=lf
*.txt        text

# Config files - enforce LF for Linux build environments
*.yml        text eol=lf
*.toml       text eol=lf
